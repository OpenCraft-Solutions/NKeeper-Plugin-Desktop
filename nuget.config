<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- NKeeper's SDK, plugin build and test helpers come from GitHub Packages, which needs a token even for public
       packages. The credentials are never kept here: they come from the environment (NUGET_USERNAME, NUGET_TOKEN). -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="opencraft" value="https://nuget.pkg.github.com/OpenCraft-Solutions/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="opencraft">
      <package pattern="NKeeper.*" />
    </packageSource>
  </packageSourceMapping>
  <packageSourceCredentials>
    <opencraft>
      <add key="Username" value="%NUGET_USERNAME%" />
      <add key="ClearTextPassword" value="%NUGET_TOKEN%" />
    </opencraft>
  </packageSourceCredentials>
</configuration>
